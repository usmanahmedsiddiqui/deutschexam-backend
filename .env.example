# Copy to .env and fill in values.
# For local dev the defaults below work as-is; in prod set APP_ENVIRONMENT=prod
# which makes the app refuse to start unless all secrets are provided (SEC-3).

# "dev" relaxes secret validation; "prod" enforces it.
APP_ENVIRONMENT=dev

DATABASE_URL=jdbc:postgresql://localhost:5432/deutschexam
DATABASE_USER=deutschexam
DATABASE_PASSWORD=deutschexam
POSTGRES_DB=deutschexam

# Must be at least 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=dev-secret-change-in-production-min-32-chars
# Optional — defaults: access token 24h, refresh token 30 days
# JWT_EXPIRY_HOURS=24
# JWT_REFRESH_TOKEN_EXPIRY_DAYS=30

# Google OAuth — get this from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
